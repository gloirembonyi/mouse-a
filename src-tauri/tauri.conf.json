{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kudu Desktop",
  "version": "0.2.3",
  "identifier": "com.thothai.mouseai",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kudu Desktop",
        "width": 960,
        "height": 700,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "minWidth": 680,
        "minHeight": 460
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Kudu Lens",
        "width": 380,
        "height": 64,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "minWidth": 200,
        "minHeight": 40,
        "maxWidth": 900,
        "maxHeight": 900
      },
      {
        "label": "copilot",
        "url": "copilot.html",
        "title": "Kudu Pilot",
        "width": 680,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "shield",
        "url": "shield.html",
        "title": "Kudu Desktop Working",
        "width": 460,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5OUNDOTQ0OUNERjlGNjkKUldScG45K2NSTW1jZVlWVENHR3g0WEFWRFhDUUFEZ29Eb0RSMVNTY2YzK0ZvQkphYjZ6bEZEYU8K",
      "endpoints": [
        "https://github.com/gloirembonyi/mouse-a/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
